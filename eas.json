{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EX_DEV_CLIENT_NETWORK_INSPECTOR": "true"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_ADDRESS": "https://shelterv2-backend-production.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EX_DEV_CLIENT_NETWORK_INSPECTOR": "false",
        "EXPO_PUBLIC_BACKEND_ADDRESS": "https://shelterv2-backend-production.up.railway.app"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
